[
{{- $pages := where .Site.RegularPages "Section" "in" (slice "poetry" "prose" "fiction") -}}
{{- $count := len $pages -}}
{{- range $index, $page := $pages -}}
  {
    "title": {{ $page.Title | jsonify }},
    "url": {{ $page.RelPermalink | jsonify }},
    "section": {{ $page.Section | jsonify }},
    "sectionName": {{ cond (eq $page.Section "poetry") "诗歌" (cond (eq $page.Section "prose") "散文" "小说") | jsonify }},
    "author": {{ $page.Params.author | default "" | jsonify }},
    "description": {{ ($page.Description | default ($page.Summary | plainify | truncate 120)) | jsonify }},
    "content": {{ $page.Plain | truncate 300 | jsonify }},
    "date": {{ $page.Date.Format "2006年1月2日" | jsonify }}
  }{{ if lt (add $index 1) $count }},{{ end }}
{{- end -}}
]