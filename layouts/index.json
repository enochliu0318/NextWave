{{- $pages := where site.RegularPages "RelPermalink" "!=" "/search/" -}}
{{- $items := slice -}}
{{- range $p := $pages -}}
  {{- $section := "" -}}
  {{- with $p.Parent -}}
    {{- if eq .Kind "section" }}{{ $section = .Title }}{{ end -}}
  {{- end -}}
  {{- $items = $items | append (dict
        "title" $p.Title
        "url" $p.RelPermalink
        "author" (default "" $p.Params.author)
        "grade" (default "" $p.Params.grade)
        "date" ($p.Date.Format "2006年1月2日")
        "dateEn" ($p.Date.Format "January 2, 2006")
        "dateSort" ($p.Date.Format "2006-01-02")
        "section" $section
        "description" ($p.Description | default ($p.Summary | plainify | truncate 120))
        "text" ($p.Plain | truncate 10000)
      ) -}}
{{- end -}}{{ $items | jsonify (dict "indent" "") }}
